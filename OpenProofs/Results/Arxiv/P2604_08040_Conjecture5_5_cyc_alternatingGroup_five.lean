open Arxiv.«2604.08040»

namespace OpenProofs.Arxiv.«2604.08040»

variable (G : Type*) [Group G] [Fintype G]

/-- The explicit set of powers `g ^ 0, …, g ^ 4` of an element of `A₅`. -/
def cycA5PowFinset (g : alternatingGroup (Fin 5)) : Finset (alternatingGroup (Fin 5)) :=
  (Finset.range 5).image (fun k => g ^ k)

theorem cycA5_pow_cases :
    ∀ g : alternatingGroup (Fin 5), g ^ 1 = 1 ∨ g ^ 2 = 1 ∨ g ^ 3 = 1 ∨ g ^ 5 = 1 := by
  decide +kernel

theorem cycA5_exists_pow (g : alternatingGroup (Fin 5)) : ∃ m, 0 < m ∧ m ≤ 5 ∧ g ^ m = 1 := by
  rcases cycA5_pow_cases g with h | h | h | h
  · exact ⟨1, by norm_num, by norm_num, h⟩
  · exact ⟨2, by norm_num, by norm_num, h⟩
  · exact ⟨3, by norm_num, by norm_num, h⟩
  · exact ⟨5, by norm_num, by norm_num, h⟩

theorem cycA5_mem_zpowers_iff (g x : alternatingGroup (Fin 5)) :
    x ∈ Subgroup.zpowers g ↔ x ∈ cycA5PowFinset g := by
  obtain ⟨m, hm0, hm5, hm⟩ := cycA5_exists_pow g
  constructor
  · intro hx
    rw [← mem_powers_iff_mem_zpowers] at hx
    obtain ⟨n, rfl⟩ := hx
    simp only [cycA5PowFinset, Finset.mem_image, Finset.mem_range]
    refine ⟨n % m, lt_of_lt_of_le (Nat.mod_lt n hm0) hm5, ?_⟩
    conv_rhs => rw [← Nat.mod_add_div n m, pow_add, pow_mul, hm, one_pow, mul_one]
  · simp only [cycA5PowFinset, Finset.mem_image, Finset.mem_range]
    rintro ⟨k, -, rfl⟩
    exact Subgroup.pow_mem _ (Subgroup.mem_zpowers g) k

theorem cycA5_card_image : (Finset.univ.image cycA5PowFinset).card = 32 := by
  decide +kernel

theorem cyc_alternatingGroup_five : cyc (alternatingGroup (Fin 5)) = 32 := by
  classical
  rw [cyc, ← cycA5_card_image, ← Nat.card_eq_finsetCard]
  refine Nat.card_eq_of_bijective
    (fun H => ⟨Finset.univ.filter (· ∈ H.1), ?_⟩) ⟨?_, ?_⟩
  · obtain ⟨g, hg⟩ := (Subgroup.isCyclic_iff_exists_zpowers_eq_top _).1 H.2
    refine Finset.mem_image.2 ⟨g, Finset.mem_univ _, ?_⟩
    ext x
    simp [← cycA5_mem_zpowers_iff, hg]
  · rintro ⟨H, hH⟩ ⟨K, hK⟩ hHK
    have hHK' := congrArg Subtype.val hHK
    simp only at hHK'
    apply Subtype.ext
    ext x
    have := congrArg (x ∈ ·) hHK'
    simpa using this
  · rintro ⟨s, hs⟩
    obtain ⟨g, -, rfl⟩ := Finset.mem_image.1 hs
    refine ⟨⟨Subgroup.zpowers g, inferInstance⟩, ?_⟩
    apply Subtype.ext
    ext x
    simp [cycA5_mem_zpowers_iff]

end OpenProofs.Arxiv.«2604.08040»
